# نموذج ديال المتغيرات — كوبي هاد الملف لـ .env وعمّر القيم الحقيقية:
#   cp .env.example .env
#
# ملاحظة: ملف .env ماشي مرفوع لـ git (فيه أسرار). هادا غير نموذج للتوثيق.

# ===== قاعدة البيانات (ضروري) =====
# رابط Neon (PostgreSQL). بدلو بالرابط ديالك من Neon Dashboard.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require'
# نفس الرابط بلا pooling — كيستعملو Drizzle فـ الـ migrations.
DATABASE_URL_UNPOOLED='postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require'

# ===== تسجيل الدخول =====
# خاص يكون "true" باش تتفعّل صفحة الـ login.
# الحساب الافتراضي كيتصاوب أوتوماتيكياً: admin@kasa.com / 12345678
KASA_AUTH_REQUIRED=true
# اختياري: يفرض Secure flag على الكوكي ("true"/"false"). خليه فارغ باش يتحدد أوتوماتيكياً.
#KASA_COOKIE_SECURE=false

# ===== اختياري =====
# "false" باش ما يتسيدّوش بيانات تجريبية (demo).
#KASA_SEED_DEMO=false
